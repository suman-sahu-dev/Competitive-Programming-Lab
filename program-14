#include <stdio.h>
int main()
{
    int n, i, j;
    int a[1000];
    int duplicate;
    scanf("%d", &n);
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }
    for (i = 0; i < n; i++)
    {
        duplicate = 0;
        for (j = 0; j < i; j++)
        {
            if (a[i] == a[j])
            {
                duplicate = 1;
                break;
            }
        }
        if (duplicate == 0)
        {
            printf("%d ", a[i]);
        }
    }
    printf("\n");
    return 0;
}
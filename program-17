#include <stdio.h>

int main(void) {
    int n;
    long long fib[100];

    printf("Enter n: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Enter a number from 1 to 100.\n");
        return 1;
    }

    fib[0] = 0;
    if (n > 1) {
        fib[1] = 1;
    }

    for (int i = 2; i < n; i++) {
        fib[i] = fib[i - 1] + fib[i - 2];
    }

    for (int i = 0; i < n; i++) {
        printf("%lld%s", fib[i], i == n - 1 ? "\n" : ", ");
    }

    return 0;
}
#include <stdio.h>
int main()
{
    int n, binary[32], i = 0;
    printf("Enter a number: ");
    scanf("%d", &n);
    // Check even or odd using Bitwise AND
    if (n & 1)
        printf("The number is Odd\n");
    else
        printf("The number is Even\n");
    // Convert decimal number to binary
    if (n == 0)
    {
        printf("Binary = 0\n");
        return 0;
    }
    while (n > 0)
    {
        binary[i] = n & 1;   // Get the last bit
        n = n >> 1;          // Divide by 2 using right shift
        i++;
    }
    printf("Binary = ");
    // Print binary in reverse order
    while (i > 0)
    {
        i--;
        printf("%d", binary[i]);
    }
    printf("\n");
    return 0;
}
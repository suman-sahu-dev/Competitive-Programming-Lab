#include <stdio.h>
int main(void) {
    int start[]  = {1, 3, 0, 5, 8, 5};
    int finish[] = {2, 4, 6, 7, 9, 9};
    int n = sizeof(start) / sizeof(start[0]);
    int lastFinish = 0;
    int selected = 0;
    printf("Selected activities: ");
    for (int i = 0; i < n; i++) {
        if (start[i] >= lastFinish) {
            printf("A%d ", i + 1);
            lastFinish = finish[i];
            selected++;
        }
    }
    printf("\nMaximum number of activities: %d\n", selected);
    return 0;
}
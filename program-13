#include <stdio.h>
int main()
{
    int n, i, target;
    int a[1000];
    int low, high, mid;
    int found = -1;
    scanf("%d", &n);
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }
    scanf("%d", &target);
    low = 0;
    high = n - 1;
    while (low <= high)
    {
        mid = low + (high - low) / 2;
        if (a[mid] == target)
        {
            found = mid;
            break;
        }
        else if (a[mid] < target)
        {
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }
    printf("%d\n", found);
    return 0;
}
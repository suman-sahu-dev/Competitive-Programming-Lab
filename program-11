#include <stdio.h>
#include <string.h>
int main()
{
    char s[1000];
    char stack[1000];
    int top = -1;
    int i;
    int valid = 1;
    scanf("%999s", s);
    for (i = 0; s[i] != '\0'; i++)
    {
        if (s[i] == '(' || s[i] == '[' || s[i] == '{')
        {
            top++;
            stack[top] = s[i];
        }
        else
        {
            if (top == -1)
            {
                valid = 0;
                break;
            }
            if ((s[i] == ')' && stack[top] == '(') ||
                (s[i] == ']' && stack[top] == '[') ||
                (s[i] == '}' && stack[top] == '{'))
            {
                top--;
            }
            else
            {
                valid = 0;
                break;
            }
        }
    }
    if (top != -1)
    {
        valid = 0;
    }
    if (valid == 1)
    {
        printf("True\n");
    }
    else
    {
        printf("False\n");
    }
    return 0;
}
#include <iostream>
#include <vector>
#include <unordered_set>
using namespace std;
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    unordered_set<int> seen;
    unordered_set<int> duplicates;

    for (int x : arr) {
        if (seen.find(x) != seen.end()) {
            duplicates.insert(x);
        } else {
            seen.insert(x);
        }
    }
    for (int x : duplicates) {
        cout << x << " ";
    }

    return 0;
}